# Copy this file to rag_env/.env and fill in real values locally.
# Never commit the real .env file.

# LLM provider keys (leave empty if unused)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Provider fallback order (comma-separated)
LLM_FALLBACK_ORDER=ollama

# Simulated free token quotas (not wired to real usage yet)
ANTHROPIC_FREE_TOKEN_QUOTA=0
OPENAI_FREE_TOKEN_QUOTA=0
XAI_FREE_TOKEN_QUOTA=0

# Embeddings
VOYAGE_API_KEY=
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=voyage-3-lite

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Qdrant (vector database)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=telecom_product_docs

# n8n / reporting (optional, leave empty if unused)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
REPORT_EMAIL_TO=
