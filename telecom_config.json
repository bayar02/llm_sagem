        "FE_ConnectSat",
        "FE_Connect TER",
        "FE_GetSignalInfos",
        "DVB",
        "FE_QAM"
      ],
      "builtin": true
    },
    "parse_rf_v15": {
      "id": "parse_rf_v15",
