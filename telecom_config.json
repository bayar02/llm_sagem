        "freq_tolerance_mhz": 1,
        "missing_policy": "fail"
      },
      "builtin": true
    },
    "fe_standard": {
      "id": "fe_standard",
      "name": "FE Standard — Avertissement si manquant",
      "description": "Paramètres manquants génèrent un avertissement mais pas d'échec global.",
