  "test_rules": {
    "fe_strict": {
      "id": "fe_strict",
      "name": "FE Strict — Aucun paramètre manquant",
      "description": "Tous les paramètres ICP doivent être présents dans le log. Échec si manquant.",
      "compatible_modules": [
        "FE"
      ],
      "settings": {
